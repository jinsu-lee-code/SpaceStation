%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0698a21dc786dfb40a08307d0a35b4e4, type: 3}
  m_Name: SP_Fox
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.SpeciesData
  _id: fox
  _displayName: "\uC5EC\uC6B0"
  _description: "\uC190\uC7AC\uC8FC \uC88B\uACE0 \uD638\uAE30\uC2EC \uB9CE\uC740
    \uBB34\uB9AC. \uC26C\uACE0 \uB178\uB294 \uC790\uB9AC\uB97C \uC911\uC2DC\uD558\uACE0,
    \uBB34\uC5C7\uC774\uB4E0 \uB179\uC5EC \uC0C8\uB85C \uB9CC\uB4DC\uB294 \uC190\uC774
    \uBE60\uB974\uB2E4."
  _favoredNeed: 2
  _favoredWeight: 0.5
  _controlReaction: 0
  _techTrait: 14
  _techPerResident: 0.02
  _techMax: 0.1
  _heatTolerance: 0
  _radiationTolerance: 0.5
  _shipColor: {r: 0.95, g: 0.52, b: 0.2, a: 1}
  _arrivalLines:
  - "\uBC30 \uD55C \uCC99\uC774 \uBC29\uC8FC\uC5D0 \uB2FF\uC558\uB2E4. \uC120\uCCB4\uAC00
    \uB367\uB304 \uD310\uC73C\uB85C \uB204\uB355\uB204\uB355\uD558\uB2E4."
  - "\uC5EC\uC6B0\uB4E4\uC774\uB2E4. \uACE0\uCE5C \uB370\uB97C \uB610 \uACE0\uCCD0
    \uAC00\uBA70 \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uB2E4."
  - "\uC881\uC544\uC9C4 \uD558\uB298\uC5D0, \uC190 \uD558\uB098\uAC00 \uB354 \uB298\uC9C0\uB3C4
    \uBAA8\uB974\uACA0\uB2E4."
  _remarks:
  - Key: climax.warning.4
    Text: "\uD30C\uD3B8 \uB760\uAC00 \uC628\uB300. \uBC16\uC73C\uB85C \uBABB \uB113\uD788\uBA74
      \uC548\uC744 \uB72F\uC5B4\uACE0\uCE58\uBA74 \uB418\uC9C0!"
  - Key: chapter.start.5.Clean
    Text: "\uB2E4 \uBC1B\uC544 \uB0C8\uB124? \uADF8 \uC881\uC740 \uB370\uC11C \uC6A9\uCF00\uB3C4
      \uB9D0\uC774\uC57C."
  - Key: chapter.start.5.Hurt
    Text: "\uBE60\uB4EF\uD588\uC9C0? \uADF8\uB798\uB3C4 \uADF8\uB9CC\uD558\uBA74
      \uC19C\uC528 \uC88B\uC558\uC5B4."
  - Key: chapter.start.5.Lost
    Text: "\uB9CE\uC774\uB4E4 \uB5A0\uB0AC\uB124. \uB2E4\uC74C\uC5D4 \uCE78\uC744
      \uB354 \uC798 \uC811\uC5B4 \uBCF4\uC790\uACE0."
  - Key: ship.accept
    Text: "\uB610 \uC190\uB2D8\uC774\uB124? \uC790\uB9AC\uC57C \uBB50, \uC811\uACE0
      \uC313\uC73C\uBA74 \uB098\uC624\uC9C0!"
  - Key: ship.partial
    Text: "\uB2E4 \uBABB \uB4E4\uC600\uB124. \uCE78\uB9CC \uB109\uB109\uD588\uC5B4\uB3C4
      \uB9D0\uC774\uC57C."
  - Key: ship.refuse
    Text: "\uB3CC\uB824\uBCF4\uB0C8\uC5B4? \uC800 \uBC30\uC5D0\uB3C4 \uC4F8 \uB9CC\uD55C
      \uC190\uC774 \uC788\uC5C8\uC744 \uD150\uB370."
