  - Key: outcome.Clean
    Pole: 0
    Axis: 0
    Text: "\uBAA8\uB450 \uBB34\uC0AC\uD569\uB2C8\uB2E4. \uAE30\uB85D\uD574 \uB461\uB2C8\uB2E4."
  - Key: outcome.Clean
    Pole: 1
    Axis: 0
    Text: "\uC190\uC2E4 \uC5C6\uC74C. \uC608\uC0C1\uB300\uB85C\uC785\uB2C8\uB2E4."
  - Key: outcome.Hurt
    Pole: 0
    Axis: 0
    Text: "\uC0C1\uCC98\uB294 \uB0AC\uC9C0\uB9CC \uBC84\uD17C\uC2B5\uB2C8\uB2E4."
  - Key: outcome.Hurt
    Pole: 2
    Axis: 0
    Text: "\uB2E4\uCE5C \uACF3\uBD80\uD130 \uC0B4\uD53C\uACA0\uC2B5\uB2C8\uB2E4.
      \uBBF8\uC548\uD569\uB2C8\uB2E4."
  - Key: outcome.Lost
    Pole: 0
    Axis: 0
    Text: "\uC783\uC740 \uAC83\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uC78A\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
  - Key: outcome.Lost
    Pole: 2
    Axis: 3
    Text: "\uC783\uC740 \uAC83\uC740 \uC9C0\uC6B0\uACE0 \uC55E\uC73C\uB85C \uAC11\uB2C8\uB2E4."
  - Key: choice.remember
    Pole: 0
    Axis: 0
    Text: "\uC9C0\uAD6C \uCABD \uCC3D\uC744 \uC5F4\uC5B4 \uB450\uC5C8\uB2E4. \uAEBC\uC838
      \uAC00\uB294 \uBD88\uBE5B\uC744 \uC78A\uC9C0 \uC54A\uC73C\uB824\uACE0."
  - Key: choice.forget
    Pole: 0
    Axis: 0
    Text: "\uB4A4\uB97C \uBCF4\uB294 \uCC3D\uC740 \uB2EB\uC558\uB2E4. \uC774\uC81C
      \uC55E\uB9CC \uBCF8\uB2E4."
  - Key: outcome.Clean
    Pole: 1
    Axis: 3
    Text: "\uC544\uBB34\uB3C4 \uC783\uC9C0 \uC54A\uC558\uB2E4. \uC774 \uBC24\uC744
      \uAE30\uC5B5\uD574 \uB454\uB2E4."
  - Key: ship.accept
    Pole: 0
    Axis: 0
    Text: "{0} {1}\uBA85\uC744 \uBAA8\uB450 \uBC1B\uC558\uC2B5\uB2C8\uB2E4. \uC790\uB9AC\uB294
      \uD568\uAED8 \uB9CC\uB4E4\uC5B4 \uAC11\uB2C8\uB2E4."
  - Key: ship.accept
    Pole: 2
    Axis: 0
    Text: "{0} {1}\uBA85, \uBAA8\uB450 \uC5B4\uC11C \uC624\uC138\uC694."
  - Key: ship.partial
    Pole: 0
    Axis: 0
    Text: "{0} {1}\uBA85\uC744 \uBC1B\uACE0 {2}\uBA85\uC740 \uB3CC\uB824\uBCF4\uB0C8\uC2B5\uB2C8\uB2E4."
  - Key: ship.partial
    Pole: 1
    Axis: 0
    Text: "\uC218\uC6A9 \uAE30\uC900\uB300\uB85C {1}\uBA85\uB9CC \uBC1B\uC558\uC2B5\uB2C8\uB2E4.
      {2}\uBA85\uC740 \uB2E4\uC74C \uC815\uAC70\uC7A5\uC744 \uCC3E\uC544\uC57C \uD569\uB2C8\uB2E4."
  - Key: ship.refuse
    Pole: 0
    Axis: 0
    Text: "{0} {2}\uBA85\uC744 \uD0DC\uC6B4 \uBC30\uB97C \uB3CC\uB824\uBCF4\uB0C8\uC2B5\uB2C8\uB2E4.
      \uAE30\uB85D\uD574 \uB461\uB2C8\uB2E4."
  - Key: ship.refuse
    Pole: 1
    Axis: 0
    Text: "\uC9C0\uAE08 \uC788\uB294 \uC774\uB4E4\uC774 \uBA3C\uC800\uC785\uB2C8\uB2E4.
      {0} {2}\uBA85\uC740 \uBC1B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - Key: ship.refuse
    Pole: 2
    Axis: 0
    Text: "{0} {2}\uBA85\uC744 \uB3CC\uB824\uBCF4\uB0C8\uC2B5\uB2C8\uB2E4. \uC774
      \uACB0\uC815\uC774 \uBB34\uAC81\uC2B5\uB2C8\uB2E4."
  - Key: outcome.GreatMigration.Clean
    Pole: 0
    Axis: 0
    Text: "\uC0C8 \uC5BC\uAD74\uC774 \uB9CE\uC774 \uB298\uC5C8\uB2E4. \uC9D1\uC740
      \uC881\uC544\uC84C\uC9C0\uB9CC, \uADF8\uB798\uB3C4 \uB530\uB73B\uD558\uB2E4."
  - Key: outcome.GreatMigration.Clean
    Pole: 2
    Axis: 0
    Text: "\uB2E4 \uAC19\uC774 \uC0B4 \uC790\uB9AC\uB97C \uB9CC\uB4E4\uC5C8\uB2E4.
      \uC624\uB298\uC740 \uADF8\uAC78\uB85C \uB410\uB2E4."
  - Key: outcome.GreatMigration.Clean
    Pole: 1
    Axis: 0
    Text: "\uBC1B\uC740 \uB9CC\uD07C \uC148\uC774 \uB9DE\uC558\uB2E4. \uB2E4\uC74C
      \uBC30\uB3C4 \uC774\uB807\uAC8C."
  - Key: outcome.GreatMigration.Hurt
    Pole: 0
    Axis: 0
    Text: "\uBE60\uB4EF\uD588\uB2E4. \uADF8\uB798\uB3C4 \uBB38\uC740 \uB2EB\uC9C0
      \uC54A\uC558\uB2E4."
  - Key: outcome.GreatMigration.Hurt
    Pole: 1
    Axis: 1
    Text: "\uBC1B\uC744 \uB9CC\uD07C\uB9CC \uBC1B\uC558\uB2E4. \uC9C8\uC11C\uB294
      \uC9C0\uCF30\uB2E4."
  - Key: outcome.GreatMigration.Lost
    Pole: 0
    Axis: 0
    Text: "\uB2E4 \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uB2E4. \uB193\uCE5C \uC774\uB4E4\uC744
      \uC78A\uC9C0 \uC54A\uACA0\uB2E4."
  - Key: outcome.GreatMigration.Lost
    Pole: 2
    Axis: 0
    Text: "\uB193\uCE5C \uC5BC\uAD74\uB4E4\uC774 \uC790\uAFB8 \uB5A0\uC624\uB978\uB2E4."
