  _tracks:
  - _category: {fileID: 11400000, guid: f0301eff11cc5cf42987ab8562f0b6be, type: 2}
    _memories:
    - "\uC9C0\uAD6C\uC758 \uC628\uC2E4 \uAE30\uB85D. \uC720\uB9AC \uC9C0\uBD95 \uC544\uB798
      \uD1A0\uB9C8\uD1A0\uAC00 \uD55C\uACA8\uC6B8\uC5D0\uB3C4 \uBD89\uAC8C \uC775\uC5C8\uB2E4."
    - "\uD574\uAC00 \uC9C0\uC9C0 \uC54A\uB294 \uC5EC\uB984\uC758 \uBD81\uCABD \uB9C8\uC744.
      \uC9C0\uBD95\uB9C8\uB2E4 \uAC80\uC740 \uD310\uC774 \uD574\uB97C \uB530\uB77C
      \uB3CC\uC558\uB2E4."
    - "\uB9C8\uC9C0\uB9C9 \uC885\uC790 \uC740\uD589\uC758 \uBAA9\uB85D. \uC528\uC557
      4\uB9CC \uC885, \uBD09\uD22C\uB9C8\uB2E4 \uB204\uAD70\uAC00\uC758 \uC190\uAE00\uC528
      \uC774\uB984\uD45C."
    _sealedHuman: "\uBAA9\uB85D \uB05D\uC758 \uBA54\uBAA8: '\uBC29\uC8FC\uC5D0\uB294
      \uC528\uC557\uBCF4\uB2E4 \uBA3C\uC800 \uC774\uAC83\uC744 \uC2E4\uC5B4\uB77C.'
      \uBB34\uC5C7\uC744 \uAC00\uB9AC\uD0A4\uB294\uC9C0\uB294 \uC9C0\uC6CC\uC838
      \uC788\uB2E4."
    _overwriteModifiers:
    - Stat: 10
      Value: 1.3000001
    - Stat: 11
      Value: 0.15
    _overwriteDescription: "\uC0DD\uC0B0 +30% \xB7 \uC88B\uC740 \uC778\uC811 \uD6A8\uACFC
      +15%p"
  - _category: {fileID: 11400000, guid: 56e3f3371e89f89479e5f22fab3c690c, type: 2}
    _memories:
    - "\uB2E4\uB9AC\uB97C \uACE0\uCE58\uB294 \uC0AC\uB78C\uB4E4\uC758 \uC791\uC5C5
      \uC77C\uC9C0. \uBCFC\uD2B8 \uD558\uB098\uC5D0\uB3C4 \uB0A0\uC9DC\uAC00 \uC801\uD600
      \uC788\uB2E4."
    - "\uBB34\uB108\uC9C4 \uB3C4\uC2DC\uB97C \uB2E4\uC2DC \uC313\uC740 \uAE30\uB85D.
      \uADF8\uB4E4\uC740 \uB0A8\uC740 \uBCBD\uB3CC\uBD80\uD130 \uC138\uC5C8\uB2E4."
    - "\uBC29\uC8FC \uC124\uACC4 \uD68C\uC758\uB85D \uCCAB \uC7A5: '\uBC31 \uB144\uC744
      \uBC84\uD2F8 \uAC83. \uB204\uAD6C\uB4E0 \uACE0\uCE60 \uC218 \uC788\uC744 \uAC83.'"
    _sealedHuman: "\uD68C\uC758\uB85D \uC11C\uBA85\uB780\uC740 \uC5F4\uB450 \uCE78,
      \uC774\uB984\uC740 \uC5F4\uD55C \uAC1C. \uB9C8\uC9C0\uB9C9 \uCE78\uC740 \uBE44\uC5B4
      \uC788\uB2E4."
    _overwriteModifiers:
    - Stat: 2
      Value: 0.70000005
    - Stat: 0
      Value: 0.15
    - Stat: 1
      Value: 15
    _overwriteDescription: "\uB178\uD6C4 30% \uC644\uD654 \xB7 \uC218\uB9AC \uBE44\uC6A9
      15% \xB7 \uC218\uB9AC \uC2DC\uAC04 15\uCD08"
  - _category: {fileID: 11400000, guid: d44f5b8b00f33034792d1aedec3ac363, type: 2}
    _memories:
    - "\uC720\uC131\uC6B0 \uAD00\uCE21 \uC77C\uC9C0. \uC544\uC774\uB4E4\uC774 \uBCC4\uB625\uBCC4\uC5D0
      \uC18C\uC6D0\uC744 \uBE4C\uC5C8\uB2E4\uACE0 \uC801\uD600 \uC788\uB2E4."
    - "\uC61B \uC815\uAC70\uC7A5\uC758 \uD53C\uACA9 \uBCF4\uACE0\uC11C. \uBCBD\uC5D0
      \uB367\uB304 \uC587\uC740 \uD310 \uD558\uB098\uAC00 \uC0AC\uB78C\uC744 \uC0B4\uB838\uB2E4."
    - "\uD558\uB298\uC744 \uC9C0\uD0A4\uB358 \uB9DD\uC6D0\uACBD\uB4E4\uC758 \uB9C8\uC9C0\uB9C9
      \uACBD\uBCF4 \uAE30\uB85D."
    _sealedHuman: "\uACBD\uBCF4\uB294 \uC815\uD655\uD588\uB2E4. \uB2E4\uB9CC \uB108\uBB34
      \uB2A6\uAC8C \uBC1B\uC544\uB4E4\uC5EC\uC84C\uB2E4. \uBCF4\uACE0\uC11C \uC544\uB798\uC5D0
      \uB204\uAD70\uAC00 '\uC6B0\uB9AC\uB294 \uC54C\uACE0 \uC788\uC5C8\uB2E4'\uB77C\uACE0
      \uC801\uC5C8\uB2E4."
    _overwriteModifiers:
    - Stat: 7
      Value: 0.325
    - Stat: 6
      Value: 0.45000002
    _overwriteDescription: "\uD295\uAE40 \uBA85\uC911 33% \xB7 \uD30C\uC190 \uBA74\uC5ED
      45%"
  - _category: {fileID: 11400000, guid: e30d41d13129e3b418850224a23a8591, type: 2}
    _memories:
    - "\uC5B4\uB290 \uC9D1 \uC800\uB141 \uC2DD\uD0C1 \uC0AC\uC9C4. \uC758\uC790\uAC00
      \uD558\uB098 \uB0A8\uB294\uB2E4."
    - "\uBCD1\uC6D0 \uBCF5\uB3C4\uC5D0 \uAC78\uB9B0 \uADF8\uB9BC\uB4E4. \uC544\uC774\uB4E4\uC774
      \uADF8\uB9B0 \uD574\uB294 \uBAA8\uB450 \uC6C3\uACE0 \uC788\uB2E4."
    - "\uC774\uC6C3\uB07C\uB9AC \uB098\uB208 \uCABD\uC9C0 \uBB36\uC74C: '\uBD88 \uAEBC\uC9C0\uBA74
      \uC6B0\uB9AC \uC9D1\uC73C\uB85C \uC640\uC694.'"
    _sealedHuman: "\uCABD\uC9C0 \uD558\uB098\uB294 \uBC29\uC8FC \uC55E\uC73C\uB85C
      \uC4F0\uC600\uB2E4: '\uC6B0\uB9AC \uB300\uC2E0 \uB204\uAD70\uAC00 \uC0B4\uC544
      \uC8FC\uAE30\uB97C.' \uBCF4\uB0B8 \uC774\uC758 \uC774\uB984\uC740 \uC5C6\uB2E4."
    _overwriteModifiers:
    - Stat: 18
      Value: 2
    - Stat: 16
      Value: 12
    _overwriteDescription: "\uC218\uC6A9 \uC778\uC6D0 +2 \xB7 \uB9CC\uC871\uB3C4
      \uC0C1\uD55C +12"
