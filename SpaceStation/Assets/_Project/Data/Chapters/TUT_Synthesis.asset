  m_Name: TUT_Synthesis
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.TutorialData
  _steps:
  - _title: "\uD569\uC131 \uCC3D"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBAA8\uB4C8\uC744 \uB179\uC5EC \uD558\uB098\uB85C
      \uC787\uB294 \uBC95\uC774 \uAE30\uB85D\uC5D0 \uB0A8\uC544 \uC788\uB2E4.</color>\n\uD569\uC131\uC740
      \uC774\uBBF8 \uC9C0\uC740 \uBAA8\uB4C8 \uC5EC\uB7EC \uAC1C\uB97C \uB354 \uD070
      <b>\uC9C4\uD654 \uBAA8\uB4C8</b> \uD558\uB098\uB85C \uBC14\uAFC9\uB2C8\uB2E4.
      \uD569\uC131 \uCC3D\uC5D0\uC11C \uC774\uBC88 \uC7A5\uC5D0 \uC5F4\uB9B0 \uB808\uC2DC\uD53C\uB97C
      \uBD05\uB2C8\uB2E4."
    _goal: 9
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uB808\uC2DC\uD53C"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uCE78\uC740 \uADF8\uB300\uB85C \uB450\uACE0,
      \uC4F0\uC784\uC740 \uB354 \uD06C\uAC8C.</color>\n\uB808\uC2DC\uD53C\uB9C8\uB2E4
      \uC7AC\uB8CC\uC640 \uADDC\uACA9 \uBAA8\uC591\uC774 \uC815\uD574\uC838 \uC788\uC2B5\uB2C8\uB2E4.
      \uD558\uB098\uB97C \uACE8\uB77C [\uC704\uCE58 \uC9C0\uC815]\uC744 \uB204\uB974\uBA74
      \uC815\uAC70\uC7A5 \uC704\uC5D0 \uADDC\uACA9\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    _goal: 10
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uD569\uC131 \uC2DC\uC791"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uC61B \uBAA8\uC591\uC774 \uC0AC\uB77C\uC9C0\uACE0
      \uC0C8 \uBAA8\uC591\uC774 \uB0A8\uB294\uB2E4.</color>\n\uC7AC\uB8CC \uBAA8\uB4C8\uC774
      \uADDC\uACA9 \uCE78\uC744 \uBE48\uD2C8\uC5C6\uC774 \uCC44\uC6B4 \uC790\uB9AC\uB97C
      \uD074\uB9AD\uD558\uBA74 \uBE44\uC6A9\uC744 \uB0B4\uACE0 \uD569\uC131\uC774
      \uC2DC\uC791\uB429\uB2C8\uB2E4. \uADF8\uB3D9\uC548 \uC7AC\uB8CC\uB294 \uBA48\uCD94\uACE0,
      \uB05D\uB098\uBA74 \uAC19\uC740 \uCE78\uC5D0 \uC9C4\uD654 \uBAA8\uB4C8\uC774
      \uC0DD\uAE41\uB2C8\uB2E4."
    _goal: 11
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  _cameraRotateDegrees: 45
  _cameraZoomDistance: 4
  _cameraMoveDistance: 3
  _nightHoldLead: 5
  _requiredSpeed: 2
  _supplyDelay: 8
  _supplyMargin: 5
  _meteorDelay: 8
  _postTutorialGrace: 0
  _maintainWornDurability: 40
  _headerLabel: "\uD569\uC131"
  _finishTitle: "\uCCAB \uD569\uC131 \uC2DC\uC791"
  _finishBody: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uC881\uC740 \uD558\uB298\uC5D0\uC11C\uB294
    \uCE78\uC744 \uC544\uB07C\uB294 \uCABD\uC774 \uC624\uB798 \uBC84\uD2F4\uB2E4.</color>\n\uD569\uC131\uC774
    \uB05D\uB098\uBA74 \uAC19\uC740 \uCE78\uC5D0 \uC9C4\uD654 \uBAA8\uB4C8\uC774
    \uC0DD\uAE41\uB2C8\uB2E4 \xB7 \uC9C4\uD589\uC740 \uC67C\uCABD \uC704 \uCD94\uC801\uAE30\uC5D0
    \uD45C\uC2DC"
  _transient: 1
  _free: 1
