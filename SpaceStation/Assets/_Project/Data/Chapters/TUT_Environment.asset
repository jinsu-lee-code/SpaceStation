  _headerLabel: "\uD658\uACBD"
  _finishTitle: "\uBC29\uC5F4\uD310 \uAC00\uB3D9"
  _finishBody: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBC14\uAE65\uC774 \uC548\uCABD\uC744
    \uC9C0\uD0A8\uB2E4. \uADF8\uB7FC \uBC14\uAE65\uC5D0\uB294 \uB204\uAC00 \uC0AC\uB098.</color>\n\uD798\uB4E0
    \uC8FC\uBBFC\uC740 \uB35C \uD798\uB4E0 \uBE48\uC9D1\uC73C\uB85C \uC800\uC808\uB85C
    \uC62E\uACA8 \uAC11\uB2C8\uB2E4 \xB7 \uC9D1\uC758 \uBC29\uC0AC\uC120\uC740 \uC704
    \xB7 \uC544\uB798 \xB7 \uC606 \uC911 \uAC00\uC7A5 \uC587\uC740 \uCABD\uC73C\uB85C
    \uC815\uD574\uC9D1\uB2C8\uB2E4 \xB7 \uC7A5\uAC11 \uACA9\uBCBD(2\uACB9) \xB7 \uCC28\uD3D0\uC2E4\uB85C
    \uB0AE\uCDA5\uB2C8\uB2E4"
