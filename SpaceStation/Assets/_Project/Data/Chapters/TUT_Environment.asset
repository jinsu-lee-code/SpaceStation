  _steps:
  - _title: "\uC5F4 \xB7 \uBC29\uC0AC\uC120 \uC9C0\uB3C4"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBCC4\uC774 \uAC70\uCE60\uC5B4\uC9C0\uACE0
      \uC788\uB2E4. \uC5B4\uB290 \uCE78\uC774 \uC704\uD5D8\uD55C\uC9C0\uBD80\uD130
      \uBCF8\uB2E4.</color>\n\uC9D1\uC758 \uC5F4\uACFC \uBC29\uC0AC\uC120\uC774 \uB192\uC73C\uBA74
      \uC8FC\uBBFC\uC774 \uD798\uB4E4\uC5B4\uD569\uB2C8\uB2E4. \uBC14\uAE65 \uCE78\uACFC
      \uD575\uC735\uD569\uB85C \uC606 \uC9D1\uC77C\uC218\uB85D \uBC29\uC0AC\uC120\uC774
      \uB192\uACE0, \uC885\uC871\uB9C8\uB2E4 \uACAC\uB514\uB294 \uC815\uB3C4\uAC00
      \uB2E4\uB985\uB2C8\uB2E4."
    _goal: 12
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uBC29\uC5F4\uD310"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uC5F4\uC740 \uBC14\uAE65\uC73C\uB85C
      \uB0B4\uBCF4\uB0B8\uB2E4.</color>\n\uBC29\uC5F4\uD310\uC740 \uB9DE\uB2FF\uC740
      \uBAA8\uB4C8\uC758 \uC5F4\uC744 \uC904\uC785\uB2C8\uB2E4. \uC6B0\uC8FC\uB85C
      \uB178\uCD9C\uB41C \uBA74\uC774 \uC788\uC5B4\uC57C \uB3D9\uC791\uD569\uB2C8\uB2E4."
