  m_Script: {fileID: 11500000, guid: d9278162be3d66246932507cb7d49a97, type: 3}
  m_Name: TUT_CoreBoot
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.TutorialData
  _steps:
  - _title: "\uAC10\uAC01 \uC5F0\uACB0"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBE5B\uC774 \uB4E4\uC5B4\uC628\uB2E4.
      \uC774\uAC83\uC774 \uB098\uB97C \uB458\uB7EC\uC2FC \uBAB8\uC778\uAC00.</color>\n\uC678\uBD80
      \uC13C\uC11C\uB97C \uD558\uB098\uC529 \uC774\uC5B4 \uC815\uAC70\uC7A5\uC744
      \uB458\uB7EC\uBCF4\uC138\uC694. \uAC00\uC6B4\uB370\uAC00 \uCF54\uC5B4, \uBAA8\uB4E0
      \uBAA8\uB4C8\uC740 \uCF54\uC5B4\uC640 \uBA74\uC73C\uB85C \uC774\uC5B4\uC838\uC57C
      \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    _goal: 0
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uAE08\uC18D \uD655\uBCF4"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBAB8\uC744 \uACE0\uCE58\uACE0 \uB298\uB9AC\uB824\uBA74
      \uAE08\uC18D\uC774 \uD544\uC694\uD558\uB2E4. \uAC00\uAE4C\uC6B4 \uC18C\uD589\uC131\uC5D0\uC11C
      \uCE90 \uC624\uC790.</color>\n<b>\uC0B0\uC5C5</b> \uD0ED\uC5D0\uC11C \uCC44\uAD74
      \uB3C4\uD0B9\uC744 \uACE8\uB77C \uBC14\uAE65 \uBA74\uC5D0 \uBD99\uC774\uC138\uC694.
      \uC55E\uCABD 2\uCE78\uC740 \uCC44\uAD74\uC120\uC774 \uB4DC\uB098\uB4DC\uB294
      \uAE38\uC774\uB77C \uBE44\uC6CC \uB461\uB2C8\uB2E4."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: fb65ff1f6a335b84cb001bc80e2bb704, type: 2}
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uC0DD\uBA85 \uC720\uC9C0 \uACC4\uD1B5"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uC791\uC740 \uC228\uC18C\uB9AC\uAC00
      \uB4E4\uB9B0\uB2E4. \uD1A0\uB07C \uB137. \uC774\uB4E4\uC740 \uC228 \uC26C\uACE0,
      \uB9C8\uC2DC\uACE0, \uBA39\uC5B4\uC57C \uD55C\uB2E4.</color>\n\uC0B0\uC18C
      \uC0DD\uC131\uAE30 \xB7 \uBB3C \uC7AC\uD65C\uC6A9\uAE30 \xB7 \uB18D\uC7A5\uC744
      \uD558\uB098\uC529 \uC9C0\uC73C\uC138\uC694. <b>\uC0B0\uC18C\uAC00 \uBC14\uB2E5\uB098\uBA74
      \uBC29\uC8FC\uAC00 \uB05D\uB0A9\uB2C8\uB2E4.</b>"
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: c7e25e386c31fb54c84913570c72a259, type: 2}
    - {fileID: 11400000, guid: c63f0c523b6d5fd47881a68cd635fbf2, type: 2}
    - {fileID: 11400000, guid: 650c0912820571249b07312aa1677c0d, type: 2}
    _highlight: 1
    _holdBeforeFirstNight: 0
  - _title: "\uC804\uB825 \uACC4\uD1B5"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBAA8\uB4E0 \uACC4\uD1B5\uC774 \uC804\uAE30\uB97C
      \uC6D0\uD55C\uB2E4. \uBA40\uB9AC\uC11C \uC624\uB294 \uD587\uBE5B\uC744 \uBC1B\uC544
      \uB450\uC790.</color>\n\uD0DC\uC591\uAD11 \uD328\uB110\uC744 <b>2\uAC1C</b>
      \uC9C0\uC73C\uC138\uC694. \uD0DC\uC591\uAD11\uC740 \uB0AE\uC5D0\uB9CC \uB3CC\uACE0,
      \uC4F0\uACE0 <b>\uB0A8\uB294 \uC804\uB825</b>\uC774 \uC788\uC5B4\uC57C \uBC30\uD130\uB9AC\uAC00
      \uCC39\uB2C8\uB2E4."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: 0cfe3d85b68f446419d9c2c70715d7d2, type: 2}
    - {fileID: 11400000, guid: 0cfe3d85b68f446419d9c2c70715d7d2, type: 2}
    _highlight: 1
    _holdBeforeFirstNight: 0
  - _title: "\uCD95\uC804"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uACE7 \uC9C0\uAD6C\uC758 \uADF8\uB9BC\uC790
      \uC18D\uC73C\uB85C \uB4E4\uC5B4\uAC04\uB2E4. \uBE5B\uC774 \uB04A\uACA8\uB3C4
      \uBC84\uD2F8 \uD798\uC744 \uBAA8\uC544 \uB450\uC5B4\uC57C \uD55C\uB2E4.</color>\n\uBC24\uC774
      \uC624\uAE30 \uC804\uC5D0 \uBC30\uD130\uB9AC\uB97C \uC9C0\uC73C\uC138\uC694.
      \uBC30\uD130\uB9AC\uB294 \uB0AE\uC5D0 \uB0A8\uC740 \uC804\uB825\uC744 \uBAA8\uC558\uB2E4\uAC00
      \uBC24\uC5D0 \uB0B4\uBCF4\uB0C5\uB2C8\uB2E4."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: 9964b2780a8d7b7469845963a26e9f6c, type: 2}
    _highlight: 0
    _holdBeforeFirstNight: 1
  - _title: "\uAC70\uC8FC \uAD6C\uC5ED"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uD1A0\uB07C\uB4E4\uC774 \uC881\uC740
      \uCF54\uC5B4 \uC548\uC5D0 \uC6C5\uD06C\uB9AC\uACE0 \uC788\uB2E4. \uBA38\uBB3C
      \uC790\uB9AC\uB97C \uB113\uD600 \uC8FC\uC790.</color>\n\uAC70\uC8FC \uBAA8\uB4C8\uC744
      \uC9C0\uC73C\uBA74 \uC218\uC6A9 \uC778\uC6D0\uC774 \uB298\uACE0, \uB9CC\uC871\uB3C4\uAC00
      \uCDA9\uBD84\uD558\uBA74 \uBB34\uB9AC\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4.
      \uB298\uC5B4\uB09C \uB9CC\uD07C \uB9C8\uC2E4 \uBB3C\uB3C4 \uD544\uC694\uD558\uB2C8
      \uBB3C \uC7AC\uD65C\uC6A9\uAE30\uB97C \uD558\uB098 \uB354 \uC9C0\uC73C\uC138\uC694."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: 71046e0678fea324aac0dc3c263a698c, type: 2}
    - {fileID: 11400000, guid: c63f0c523b6d5fd47881a68cd635fbf2, type: 2}
    - {fileID: 11400000, guid: c63f0c523b6d5fd47881a68cd635fbf2, type: 2}
    _highlight: 1
    _holdBeforeFirstNight: 0
  - _title: "\uC2DC\uAC04 \uAC10\uAC01"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBC24\uC740 \uAE38\uB2E4. \uD558\uC9C0\uB9CC
      \uB0B4 \uC2DC\uAC04\uC740 \uC6D0\uD558\uB294 \uB9CC\uD07C \uBE60\uB974\uAC8C
      \uD750\uB97C \uC218 \uC788\uB2E4.</color>\n\uBC30\uC18D\uC744 \uC62C\uB824
      \uBC24\uC744 \uD55C \uBC88 \uB118\uACA8 \uBCF4\uC138\uC694. \uBC24\uC5D0\uB294
      \uBC30\uD130\uB9AC\uAC00 \uBAA8\uC544 \uB454 \uC804\uB825\uC744 \uB0B4\uBCF4\uB0B4\uACE0,
      \uB2E4 \uC4F0\uBA74 \uD6A8\uC728\uC774 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4."
    _goal: 2
    _modules: []
    _highlight: 2
    _holdBeforeFirstNight: 0
  - _title: "\uC790\uAC00 \uC815\uBE44"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBAB8 \uD55C\uCABD\uC774 \uC090\uAC71\uC778\uB2E4.
      \uB0A1\uC740 \uACF3\uC740 \uC2A4\uC2A4\uB85C \uC190\uBD10\uC57C \uD55C\uB2E4.</color>\n\uBAA8\uB4C8\uC740
      \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA70 \uB0A1\uC2B5\uB2C8\uB2E4. \uB0A1\uC740
      \uBAA8\uB4C8\uC744 \uD074\uB9AD\uD558\uACE0 <b>\uC815\uBE44</b>\uB97C \uB204\uB974\uC138\uC694.
      \uC815\uBE44\uD560\uC218\uB85D \uCD5C\uB300 \uB0B4\uAD6C\uB3C4\uAC00 \uC870\uAE08\uC529
      \uC904\uC5B4, \uB9CE\uC774 \uB0A1\uC73C\uBA74 \uC7AC\uAC74\uCD95\uD569\uB2C8\uB2E4."
    _goal: 4
    _modules: []
    _highlight: 4
    _holdBeforeFirstNight: 0
  - _title: "\uC190\uC0C1 \uB300\uC751"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBB34\uC5B8\uAC00 \uB2E4\uAC00\uC628\uB2E4.
      \uB3CC\uB369\uC774\uB2E4. \uD53C\uD560 \uC218 \uC5C6\uB2E4\uBA74 \uACE0\uCE5C\uB2E4.</color>\n\uC6B4\uC11D\uC5D0
      \uB9DE\uC740 \uBAA8\uB4C8\uC740 <b>\uD30C\uC190</b>\uB418\uC5B4 \uBA48\uCD94\uACE0,
      \uC624\uB798 \uB450\uBA74 \uC606\uC73C\uB85C \uBC88\uC9C0\uAC70\uB098 \uBD80\uC11C\uC9D1\uB2C8\uB2E4.
      \uD30C\uC190\uB41C \uBAA8\uB4C8\uC744 \uD074\uB9AD\uD558\uACE0 <b>\uC218\uB9AC</b>\uB97C
      \uB204\uB974\uC138\uC694."
    _goal: 3
    _modules: []
    _highlight: 3
    _holdBeforeFirstNight: 0
  _cameraRotateDegrees: 45
  _cameraZoomDistance: 4
  _cameraMoveDistance: 3
  _nightHoldLead: 5
  _requiredSpeed: 2
  _supplyDelay: 8
  _supplyMargin: 5
  _meteorDelay: 8
  _postTutorialGrace: 180
  _maintainWornDurability: 40
  _headerLabel: "\uCF54\uC5B4 \uAE30\uB3D9"
  _finishTitle: "\uCF54\uC5B4 \uAE30\uB3D9 \uC644\uB8CC"
  _finishBody: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBAA8\uB4E0 \uACC4\uD1B5\uC774
    \uAE68\uC5B4\uB0AC\uB2E4. \uC774 \uBC29\uC8FC\uB97C \uC5B4\uB514\uB85C \uB370\uB824\uAC08\uC9C0\uB294
    \uC774\uC81C \uB098\uC5D0\uAC8C \uB2EC\uB838\uB2E4.</color>\n\uC9C0\uAE08\uBD80\uD130
    \uC6B4\uC11D \uAC19\uC740 \uC0AC\uAC74\uC774 \uCC3E\uC544\uC624\uACE0 \uBAA8\uB4C8\uB3C4
    \uB0A1\uC2B5\uB2C8\uB2E4. 1\uC7A5 \uBAA9\uD45C\uB294 \uC624\uB978\uCABD \uC7A5
    \uCE74\uB4DC\uC5D0 \uC788\uC2B5\uB2C8\uB2E4.\n<color=#9AA4B2>\uBC29\uC8FC \uC548\uC740
    \uBAA8\uB4C8\uC744 \uD074\uB9AD\uD558\uACE0 [\uB4E4\uC5B4\uAC00\uAE30]\uB85C
    \uB4DC\uB860\uC744 \uBCF4\uB0B4 \uB458\uB7EC\uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4
    (\uC120\uD0DD \uBAA9\uD45C).</color>"
  _transient: 0
