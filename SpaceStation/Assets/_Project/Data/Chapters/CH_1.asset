  m_Script: {fileID: 11500000, guid: d5779d0e21f0e9647a0c673d17ae6ed5, type: 3}
  m_Name: CH_1
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.ChapterData
  _displayName: "1\uC7A5"
  _subtitle: "\uAE68\uC5B4\uB0A8"
  _introSpeaker: "\uBC29\uC8FC \uC2DC\uC2A4\uD15C \uC74C\uC131 \xB7 \uB179\uC74C"
  _introLines:
  - "\uC804\uC6D0 \uBCF5\uAD6C\uB97C \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - "\uBC29\uC8FC \uC6B4\uC601 \uC9C0\uB2A5 '\uCF54\uC5B4'. \uAE30\uB3D9 \uC808\uCC28\uB97C
    \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - "\uC2B9\uC120 \uD655\uC778. \uD1A0\uB07C 4. \uC778\uAC04 \uC2B9\uC120\uC790 0."
  - "\uCD9C\uBC1C\uC9C0 \uC9C0\uAD6C \uC800\uADA4\uB3C4. \uB3C4\uCC29\uC9C0\uB294
    \uC9C0\uC815\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  - "\uB0A8\uACA8\uC9C4 \uC9C0\uC2DC\uB97C \uC7AC\uC0DD\uD569\uB2C8\uB2E4. \"\uC774\uB4E4\uC744
    \uC0B4\uB824 \uC918. \uC6B0\uB9AC\uAC00 \uD558\uC9C0 \uBABB\uD55C \uBC29\uC2DD\uC73C\uB85C.\""
  - "\uC7AC\uC0DD \uB05D. \uC774\uD6C4\uC758 \uBAA8\uB4E0 \uD310\uB2E8\uC740 \uCF54\uC5B4\uC5D0\uAC8C
    \uB9E1\uAE41\uB2C8\uB2E4."
  - "\uCF54\uC5B4: ...\uBE5B\uC774 \uB4E4\uC5B4\uC628\uB2E4. \uC5EC\uAE30\uB294 \uC5B4\uB514\uC9C0.
    \uC544\uB2C8, \uB098\uB294 \uBB34\uC5C7\uC774\uC9C0."
  _interiorGuide: {fileID: 11400000, guid: fcefd6502c372e24aa5626e3bec0f851, type: 2}
