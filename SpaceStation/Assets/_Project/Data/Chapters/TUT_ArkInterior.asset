  m_Script: {fileID: 11500000, guid: d9278162be3d66246932507cb7d49a97, type: 3}
  m_Name: TUT_ArkInterior
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.TutorialData
  _steps:
  - _title: "\uB4DC\uB860 \uC5F0\uACB0"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uBAB8 \uC548\uCABD\uC740 \uC791\uC740
      \uB4DC\uB860\uC758 \uB208\uC73C\uB85C \uBCF8\uB2E4.</color>\n\uC774\uB3D9 \uD0A4\uC640
      \uB9C8\uC6B0\uC2A4\uB85C \uC6C0\uC9C1\uC774\uACE0, ESC\uB85C \uBC16\uC5D0 \uB098\uC635\uB2C8\uB2E4.
      \uB098\uC624\uBA74 \uC774 \uC548\uB0B4\uB294 \uBA48\uCD94\uACE0 \uB2E4\uC74C\uC5D0
      \uB4E4\uC5B4\uC62C \uB54C \uCC98\uC74C\uBD80\uD130 \uD569\uB2C8\uB2E4."
    _goal: 5
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uBC29\uC8FC \uC9C0\uB3C4"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uB4DC\uB860\uC758 \uD328\uB4DC\uC5D0
      \uBC29\uC8FC \uC9C0\uB3C4\uAC00 \uB5A0 \uC788\uB2E4.</color>\n\uD328\uB4DC\uB97C
      \uB4E4\uC5B4 \uBCF4\uC138\uC694. \uBD80\uD0C1\uC774\uB098 \uC0AC\uACE0\uAC00
      \uC0DD\uAE34 \uBC29\uC774 \uC9C0\uB3C4\uC5D0 \uD45C\uC2DC\uB418\uACE0, \uB2E4\uB978
      \uBC29\uC73C\uB85C \uBC14\uB85C \uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _goal: 6
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uC791\uC740 \uBD80\uD0C1"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uD1A0\uB07C \uD558\uB098\uAC00 \uBB34\uC5B8\uAC00
      \uBD80\uD0C1\uD55C\uB2E4. \uC791\uC740 \uC77C\uC774\uC9C0\uB9CC, \uB4E4\uC5B4\uC8FC\uBA74
      \uBB34\uB9AC\uAC00 \uD3B8\uD574\uC9C4\uB2E4.</color>\n\uBD80\uD0C1\uD55C \uC8FC\uBBFC\uC740
      \uD654\uBA74 \uC704\uCABD \uBC29 \uC774\uB984 \uC544\uB798\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4.
      \uCC3E\uC544\uAC00 \uB4E4\uC5B4\uC8FC\uBA74 <b>\uB9CC\uC871\uB3C4</b>\uAC00
      \uC624\uB985\uB2C8\uB2E4."
    _goal: 7
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uACBD\uBCF4"
    _body: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uC5B4\uB518\uAC00\uC5D0\uC11C \uACBD\uBCF4\uAC00
      \uC6B8\uB9B0\uB2E4. \uB4DC\uB860\uC73C\uB85C \uC9C1\uC811 \uB9C9\uC544 \uBCF4\uC790.</color>\n\uD3C9\uC18C\uC5D0\uB294
      \uC81C\uD55C \uC2DC\uAC04 \uC548\uC5D0 \uB9C9\uC9C0 \uBABB\uD558\uBA74 \uC790\uC6D0\uC744
      \uC783\uC2B5\uB2C8\uB2E4. <color=#9AA4B2>\uC774\uBC88\uC740 \uC5F0\uC2B5\uC774\uB77C
      \uC2DC\uAC04 \uC81C\uD55C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.</color>"
    _goal: 8
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  _cameraRotateDegrees: 45
  _cameraZoomDistance: 4
  _cameraMoveDistance: 3
  _nightHoldLead: 5
  _requiredSpeed: 2
  _supplyDelay: 8
  _supplyMargin: 5
  _meteorDelay: 8
  _postTutorialGrace: 0
  _maintainWornDurability: 40
  _headerLabel: "\uBC29\uC8FC \uC548"
  _finishTitle: "\uBC29\uC8FC \uC548 \uB458\uB7EC\uBCF4\uAE30 \uC644\uB8CC"
  _finishBody: "<color=#9FE8FF>\uCF54\uC5B4 \xB7 \uC774\uB4E4\uC758 \uBAA9\uC18C\uB9AC\uB294
    \uBC16\uC5D0\uC11C\uB294 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4.</color>\nESC\uB85C
    \uBC16\uC5D0 \uB098\uC635\uB2C8\uB2E4."
  _transient: 1
