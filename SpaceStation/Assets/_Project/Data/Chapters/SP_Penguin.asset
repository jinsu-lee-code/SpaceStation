MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0698a21dc786dfb40a08307d0a35b4e4, type: 3}
  m_Name: SP_Penguin
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.SpeciesData
  _id: penguin
  _displayName: "\uD3AD\uADC4"
  _description: "\uC11C\uB85C \uBAB8\uC744 \uB9DE\uB300\uACE0 \uC0AC\uB294 \uCC28\uBD84\uD55C
    \uBB34\uB9AC. \uC544\uD508 \uC774\uB97C \uBA3C\uC800 \uCC59\uAE30\uACE0, \uB728\uAC70\uC6B4
    \uAC83\uC744 \uC2DD\uD788\uB294 \uBC95\uC744 \uC798 \uC548\uB2E4."
  _favoredNeed: 1
  _favoredWeight: 0.5
  _controlReaction: 0
  _techTrait: 15
  _techPerResident: 0.02
  _techMax: 0.1
  _heatTolerance: -0.5
  _radiationTolerance: 0
  _shipColor: {r: 0.55, g: 0.75, b: 0.95, a: 1}
  _arrivalLines:
  - "\uBC30 \uD55C \uCC99\uC774 \uBC29\uC8FC\uC5D0 \uB2FF\uC558\uB2E4. \uC120\uCCB4\uC5D0
    \uC544\uC9C1 \uC11C\uB9AC\uAC00 \uB0A8\uC544 \uC788\uB2E4."
  - "\uD3AD\uADC4\uB4E4\uC774\uB2E4. \uC881\uC740 \uCE78\uC5D0 \uC11C\uB85C \uBD99\uC5B4
    \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uB2E4."
  - "\uB354\uC6B4 \uC790\uB9AC\uC5D0\uB294 \uC624\uB798 \uBABB \uC788\uC744 \uAC70\uB2E4.
    \uC5B4\uB514\uC5D0 \uC0B4\uAC8C \uD560\uC9C0 \uBD10 \uB46C\uC57C \uD55C\uB2E4."
  _remarks:
  - Key: ship.accept
    Text: "\uC6B0\uB9AC\uB97C \uBC1B\uC544 \uC8FC\uC168\uAD70\uC694. \uC6B0\uB9AC\uB3C4
      \uC190\uC744 \uBCF4\uD0DC\uC9C0\uC694."
  - Key: ship.partial
    Text: "\uC77C\uBD80\uB9CC \uC624\uB978\uB2E4\uC9C0\uC694. \uC6B0\uB9AC\uB294
      \uB0A8\uC740 \uC774\uB4E4\uC744 \uAE30\uC5B5\uD569\uB2C8\uB2E4."
  - Key: ship.refuse
    Text: "\uB3CC\uC544\uAC00\uB77C \uD558\uC2DC\uB294\uAD70\uC694. \uC6B0\uB9AC\uB294
      \uB2E4\uB978 \uACF3\uC744 \uCC3E\uC544\uBCF4\uC9C0\uC694."
