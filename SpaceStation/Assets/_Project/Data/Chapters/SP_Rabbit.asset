%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0698a21dc786dfb40a08307d0a35b4e4, type: 3}
  m_Name: SP_Rabbit
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.SpeciesData
  _id: rabbit
  _displayName: "\uD1A0\uB07C"
  _description: "\uAC81\uC774 \uB9CE\uC9C0\uB9CC \uBD80\uC9C0\uB7F0\uD55C \uBB34\uB9AC.
    \uC544\uD50C \uB54C \uB3CC\uBD10 \uC904 \uACF3\uC744 \uBA3C\uC800 \uCC3E\uACE0,
    \uD143\uBC2D\uC744 \uC798 \uAC00\uAFBC\uB2E4."
  _favoredNeed: 1
  _favoredWeight: 0.5
  _controlReaction: 0.5
  _techTrait: 2
  _techPerResident: 0.02
  _techMax: 0.1
  _heatTolerance: 0
  _radiationTolerance: 0
  _shipColor: {r: 0.95, g: 0.62, b: 0.72, a: 1}
  _arrivalLines:
  - "\uD1A0\uB07C\uB4E4\uC774 \uD0C4 \uBC30\uB2E4. \uB0AF\uC775\uC740 \uC5BC\uAD74\uB4E4\uC774\uB2E4."
  _remarks:
  - Key: chapter.start.1
    Text: "\uBD88\uC774 \uB4E4\uC5B4\uC654\uC5B4\uC694! \uC774\uC81C \uC5EC\uAE30\uC11C
      \uC0B4 \uC218 \uC788\uB294 \uAC70\uC8E0?"
  - Key: chapter.start.2.Clean
    Text: "\uAE34 \uBC24\uC744 \uC544\uBB34\uB3C4 \uC548 \uB2E4\uCE58\uACE0 \uB118\uACBC\uC5B4\uC694.
      \uCF54\uC5B4 \uB355\uBD84\uC774\uC5D0\uC694."
  - Key: chapter.start.2.Hurt
    Text: "\uBC24\uC0C8 \uBB34\uC11C\uC6E0\uC5B4\uC694. \uADF8\uB798\uB3C4 \uB2E4\uB4E4
      \uC0B4\uC544 \uC788\uC5B4\uC694."
  - Key: chapter.start.2.Lost
    Text: "\uC5B4\uC82F\uBC24 \uC77C\uC740 \uC544\uC9C1 \uC0DD\uAC01\uD558\uAE30
      \uC2EB\uC5B4\uC694."
  - Key: chapter.start.2
    Text: "\uC815\uAC70\uC7A5\uC774 \uC870\uAE08\uC529 \uCEE4\uC9C0\uACE0 \uC788\uC5B4\uC694."
  - Key: chapter.start.3.Clean
    Text: "\uBCC4\uB625\uBE44\uAC00 \uB2E4 \uBE44\uCF1C \uAC14\uC5B4\uC694! \uC815\uB9D0
      \uB2E4\uD589\uC774\uC5D0\uC694."
  - Key: chapter.start.3.Hurt
    Text: "\uC5EC\uAE30\uC800\uAE30 \uAE01\uD614\uC9C0\uB9CC, \uADF8\uB798\uB3C4
      \uBC84\uD17C\uC5B4\uC694."
  - Key: chapter.start.3.Lost
    Text: "\uBD80\uC11C\uC9C4 \uBC29\uC744 \uBCFC \uB54C\uB9C8\uB2E4 \uB9C8\uC74C\uC774
      \uC544\uD30C\uC694."
  - Key: chapter.start.3
    Text: "\uB2E4\uB978 \uBB34\uB9AC\uB3C4 \uC628\uB2E4\uB294 \uC18C\uBB38\uC774
      \uC788\uC5B4\uC694. \uC870\uAE08 \uB5A8\uB824\uC694."
  - Key: climax.warning.1
    Text: "\uBC24\uC774 \uAE38\uC5B4\uC9C4\uB300\uC694. \uBD88\uC774 \uAEBC\uC9C0\uBA74
      \uC5B4\uB5A1\uD558\uC8E0?"
  - Key: climax.warning.2
    Text: "\uD070 \uBCC4\uB625\uBE44\uAC00 \uC628\uB300\uC694. \uBC29 \uC548\uCABD\uC5D0
      \uC788\uC744\uAC8C\uC694."
  - Key: climax.warning.3
    Text: "\uBC30\uAC00 \uC5EC\uB7EC \uCC99 \uC628\uB300\uC694. \uB2E4\uB4E4 \uB4E4\uC5B4\uC62C
      \uC790\uB9AC\uAC00 \uC788\uC744\uAE4C\uC694?"
  - Key: chapter.start.4.Clean
    Text: "\uC0C8 \uC774\uC6C3\uC774 \uB9CE\uC774 \uB298\uC5C8\uC5B4\uC694. \uBCF5\uB3C4\uAC00
      \uBD81\uC801\uBD81\uC801\uD574\uC694."
  - Key: chapter.start.4.Hurt
    Text: "\uB2E4 \uD568\uAED8 \uC624\uC9C0\uB294 \uBABB\uD588\uC9C0\uB9CC, \uC628
      \uBD84\uB4E4\uC740 \uC798 \uC9C0\uB0B4\uC694."
  - Key: chapter.start.4.Lost
    Text: "\uB5A0\uB09C \uBD84\uB4E4 \uBC29\uC774 \uC544\uC9C1 \uBE44\uC5B4 \uC788\uC5B4\uC694."
  - Key: chapter.start.4
    Text: "\uD558\uB298\uC5D0 \uBC18\uC9DD\uC774\uB294 \uC870\uAC01\uC774 \uB298\uC5C8\uB300\uC694.
      \uBCC4\uB625\uBCC4\uC77C\uAE4C\uC694?"
  - Key: climax.warning.4
    Text: "\uD30C\uD3B8\uC774 \uD558\uB298\uC744 \uB36E\uB294\uB300\uC694. \uADF8\uB3D9\uC548\uC740
      \uBC29\uC744 \uB098\uB220 \uC368\uC57C\uACA0\uC5B4\uC694."
  - Key: ship.new.bear
    Text: "\uACF0\uC774\uB77C\uB2C8, \uB369\uCE58\uAC00 \uCEE4\uC11C \uC870\uAE08
      \uBB34\uC11C\uC6CC\uC694. \uADF8\uB798\uB3C4 \uC798 \uC9C0\uB0B4 \uBCFC\uAC8C\uC694."
  - Key: ship.new.fox
    Text: "\uC5EC\uC6B0\uB4E4\uC774\uC5D0\uC694! \uC190\uC7AC\uC8FC\uAC00 \uC88B\uB2E4\uB358\uB370,
      \uACE0\uC7A5 \uB09C \uAC83\uB3C4 \uACE0\uCCD0 \uC904\uAE4C\uC694?"
  - Key: ship.accept
    Text: "\uC0C8 \uC774\uC6C3\uC774 \uC654\uC5B4\uC694! \uBC29\uC744 \uAC19\uC774
      \uAFB8\uBA70\uC57C\uACA0\uC5B4\uC694."
  - Key: ship.partial
    Text: "\uB2E4 \uAC19\uC774 \uC624\uC9C0\uB294 \uBABB\uD588\uB124\uC694. \uB0A8\uC740
      \uBD84\uB4E4\uB3C4 \uBB34\uC0AC\uD558\uBA74 \uC88B\uACA0\uC5B4\uC694."
  - Key: ship.refuse
    Text: "\uBC30\uAC00 \uB3CC\uC544\uAC00\uC694. \uC800 \uC548\uC5D0\uB3C4 \uB204\uAD70\uAC00
      \uC788\uC5C8\uC744 \uD150\uB370."
