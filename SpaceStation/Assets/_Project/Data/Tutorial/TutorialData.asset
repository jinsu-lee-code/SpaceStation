  m_Script: {fileID: 11500000, guid: d9278162be3d66246932507cb7d49a97, type: 3}
  m_Name: TutorialData
  m_EditorClassIdentifier: SpaceStation::SpaceStation.Data.TutorialData
  _steps:
  - _title: "\uC815\uAC70\uC7A5 \uB458\uB7EC\uBCF4\uAE30"
    _body: "\uC9C0\uD718\uAD00\uB2D8, \uD658\uC601\uD569\uB2C8\uB2E4. \uAC00\uC6B4\uB370
      \uBAA8\uB4C8\uC774 \uC815\uAC70\uC7A5\uC758 \uC2EC\uC7A5\uC778 <b>\uCF54\uC5B4</b>\uC785\uB2C8\uB2E4.\n\uBAA8\uB4E0
      \uBAA8\uB4C8\uC740 \uCF54\uC5B4\uC640 \uBA74\uC73C\uB85C \uC774\uC5B4\uC838
      \uC788\uC5B4\uC57C \uC791\uB3D9\uD569\uB2C8\uB2E4. \uBA3C\uC800 \uCE74\uBA54\uB77C\uB85C
      \uC815\uAC70\uC7A5\uC744 \uB458\uB7EC\uBCF4\uC138\uC694."
    _goal: 0
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uAE08\uC18D \uD655\uBCF4: \uCC44\uAD74 \uB3C4\uD0B9"
    _body: "\uAE08\uC18D\uC740 \uBAA8\uB4E0 \uAC74\uC124\uACFC \uC218\uB9AC\uC758
      \uC7AC\uB8CC\uC785\uB2C8\uB2E4. <b>\uC0B0\uC5C5</b> \uD0ED\uC5D0\uC11C \uCC44\uAD74
      \uB3C4\uD0B9\uC744 \uACE8\uB77C \uC815\uAC70\uC7A5 \uBC14\uAE65 \uBA74\uC5D0
      \uBD99\uC774\uC138\uC694.\n\uB3C4\uD0B9\uC740 \uB4A4\uCABD\uC774 \uBAA8\uB4C8\uC5D0
      \uB2FF\uC544\uC57C \uD558\uACE0, \uC55E\uCABD 2\uCE78\uC740 \uCC44\uAD74\uC120
      \uC811\uADFC\uB85C\uB77C \uBE44\uC6CC \uB46C\uC57C \uD569\uB2C8\uB2E4 (\uBC14\uAE65\uC744
      \uD5A5\uD558\uB3C4\uB85D \uC790\uB3D9 \uD68C\uC804)."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: fb65ff1f6a335b84cb001bc80e2bb704, type: 2}
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uC0DD\uBA85 \uC720\uC9C0: \uC0B0\uC18C\xB7\uBB3C\xB7\uC2DD\uB7C9"
    _body: "\uAC70\uC8FC\uC790\uB294 \uC0B0\uC18C\xB7\uBB3C\xB7\uC2DD\uB7C9\uC744
      \uACC4\uC18D \uC18C\uBE44\uD569\uB2C8\uB2E4. \uAE5C\uBE61\uC774\uB294 \uC790\uC6D0
      \uD45C\uC2DC\uC5D0\uC11C \uC904\uC5B4\uB4DC\uB294 \uC591\uC744 \uD655\uC778\uD558\uC138\uC694.\n\uC0B0\uC18C
      \uC0DD\uC131\uAE30\xB7\uBB3C \uC7AC\uD65C\uC6A9\uAE30\xB7\uB18D\uC7A5\uC744
      \uD558\uB098\uC529 \uC9C0\uC5B4 \uC18C\uBE44\uB97C \uBA54\uC6B0\uC138\uC694.
      <b>\uC0B0\uC18C\uAC00 \uBC14\uB2E5\uB098\uBA74 \uAC8C\uC784 \uC624\uBC84</b>\uC785\uB2C8\uB2E4."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: c7e25e386c31fb54c84913570c72a259, type: 2}
    - {fileID: 11400000, guid: c63f0c523b6d5fd47881a68cd635fbf2, type: 2}
    - {fileID: 11400000, guid: 650c0912820571249b07312aa1677c0d, type: 2}
    _highlight: 1
    _holdBeforeFirstNight: 0
  - _title: "\uC804\uB825: \uD0DC\uC591\uAD11 \uD328\uB110"
    _body: "\uCC44\uAD74 \uB3C4\uD0B9\uACFC \uC0DD\uBA85 \uC720\uC9C0 \uBAA8\uB4C8\uC740
      \uC804\uB825\uC744 \uC501\uB2C8\uB2E4. \uC804\uB825\uC774 \uBAA8\uC790\uB77C\uBA74
      \uBAA8\uB4E0 \uBAA8\uB4C8\uC758 \uD6A8\uC728\uC774 \uD568\uAED8 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4.\n<b>\uC804\uB825</b>
      \uD0ED\uC5D0\uC11C \uD0DC\uC591\uAD11 \uD328\uB110\uC744 <b>2\uAC1C</b> \uC9C0\uC73C\uC138\uC694.
      \uD0DC\uC591\uAD11\uC740 \uB0AE\uC5D0\uB9CC \uBC1C\uC804\uD558\uACE0, \uC4F0\uACE0
      <b>\uB0A8\uB294 \uC804\uB825</b>\uC774 \uC788\uC5B4\uC57C \uBC30\uD130\uB9AC\uB97C
      \uCC44\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: 0cfe3d85b68f446419d9c2c70715d7d2, type: 2}
    - {fileID: 11400000, guid: 0cfe3d85b68f446419d9c2c70715d7d2, type: 2}
    _highlight: 1
    _holdBeforeFirstNight: 0
  - _title: "\uCCAB \uBC24 \uB300\uBE44: \uBC30\uD130\uB9AC"
    _body: "\uACE7 \uC815\uAC70\uC7A5\uC774 \uC9C0\uAD6C \uADF8\uB9BC\uC790\uC5D0
      \uB4E4\uC5B4\uAC00 <b>\uBC24</b>\uC774 \uB429\uB2C8\uB2E4. \uBC24\uC5D0\uB294
      \uD0DC\uC591\uAD11\uC774 \uBA48\uCDA5\uB2C8\uB2E4.\n\uBC30\uD130\uB9AC\uB294
      \uB0AE\uC5D0 \uB0A8\uB294 \uC804\uB825\uC744 \uBAA8\uC544 \uB450\uC5C8\uB2E4\uAC00
      \uBC24\uC5D0 \uB0B4\uBCF4\uB0C5\uB2C8\uB2E4. \uBC24\uC774 \uC624\uAE30 \uC804\uC5D0
      \uBC30\uD130\uB9AC\uB97C \uC9C0\uC73C\uC138\uC694.\n<color=#9AA4B2>\uBC30\uD130\uB9AC
      \uD558\uB098\uB85C\uB294 \uBC24 \uB0B4\uB0B4 \uBC84\uD2F0\uAE30 \uC5B4\uB824\uC6CC,
      \uBC24\uC774 \uAE4A\uC5B4\uC9C0\uBA74 \uD6A8\uC728\uC774 \uC870\uAE08 \uB5A8\uC5B4\uC9C8
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.</color>"
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: 9964b2780a8d7b7469845963a26e9f6c, type: 2}
    _highlight: 0
    _holdBeforeFirstNight: 1
  - _title: "\uC778\uAD6C \uB298\uB9AC\uAE30: \uAC70\uC8FC \uBAA8\uB4C8"
    _body: "\uC815\uAC70\uC7A5 \uB4F1\uAE09\uC740 <b>\uAC70\uC8FC\uC790 \uC218\uC640
      \uBAA8\uB4C8 \uC218</b>\uB85C \uC624\uB985\uB2C8\uB2E4. \uAC70\uC8FC \uBAA8\uB4C8\uC744
      \uC9C0\uC5B4 \uC218\uC6A9 \uC778\uC6D0\uC744 \uB298\uB9AC\uBA74, \uB9CC\uC871\uB3C4\uAC00
      \uCDA9\uBD84\uD560 \uB54C \uAC70\uC8FC\uC790\uAC00 \uCC9C\uCC9C\uD788 \uB298\uC5B4\uB0A9\uB2C8\uB2E4.\n\uC0AC\uB78C\uC774
      \uB298\uBA74 \uC18C\uBE44\uB3C4 \uB298\uC5B4\uB0A9\uB2C8\uB2E4. <b>\uBB3C \uC7AC\uD65C\uC6A9\uAE30</b>\uB3C4
      \uD558\uB098 \uB354 \uC9C0\uC73C\uC138\uC694 (\uBB3C\uC774 \uBAA8\uC790\uB77C\uBA74
      \uC0B0\uC18C \uC0DD\uC131\uAE30 \xB7 \uB18D\uC7A5\uB3C4 \uBA48\uCDA5\uB2C8\uB2E4)."
    _goal: 1
    _modules:
    - {fileID: 11400000, guid: 71046e0678fea324aac0dc3c263a698c, type: 2}
    - {fileID: 11400000, guid: c63f0c523b6d5fd47881a68cd635fbf2, type: 2}
    - {fileID: 11400000, guid: c63f0c523b6d5fd47881a68cd635fbf2, type: 2}
    _highlight: 1
    _holdBeforeFirstNight: 0
  - _title: "\uC2DC\uAC04 \uBE68\uB9AC \uAC10\uAE30"
    _body: "\uAE5C\uBE61\uC774\uB294 \uC2DC\uAC04 \uC870\uC808 \uBC84\uD2BC\uC73C\uB85C
      \uBC30\uC18D\uC744 \uC62C\uB9AC\uAC70\uB098 \uC77C\uC2DC\uC815\uC9C0\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBC30\uC18D\uC744 \uC62C\uB824 \uBC24\uC744
      \uD55C \uBC88 \uB118\uACA8 \uBCF4\uC138\uC694. \uBC24\uC5D0\uB294 \uBC30\uD130\uB9AC\uAC00
      \uBAA8\uC544 \uB454 \uC804\uB825\uC744 \uB0B4\uBCF4\uB0B4\uACE0, \uB2E4 \uC4F0\uBA74
      \uD6A8\uC728\uC774 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4 (\uC790\uC6D0 \uD45C\uC2DC\uC758
      \uBC30\uD130\uB9AC \uC904)."
    _goal: 2
    _modules: []
    _highlight: 2
    _holdBeforeFirstNight: 0
  - _title: "\uB178\uD6C4\uD654: \uC815\uBE44"
    _body: "\uBAA8\uB4C8\uC740 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA70 \uB0A1\uC2B5\uB2C8\uB2E4
      (<b>\uB0B4\uAD6C\uB3C4</b>). \uB0B4\uAD6C\uB3C4\uAC00 \uC808\uBC18 \uC544\uB798\uB85C
      \uB0B4\uB824\uAC00\uBA74 \uD6A8\uC728\uC774 \uB5A8\uC5B4\uC9D1\uB2C8\uB2E4.\n\uB0A1\uC740
      \uBAA8\uB4C8\uC744 \uD074\uB9AD\uD558\uACE0 <b>\uC815\uBE44</b>\uB97C \uB204\uB974\uC138\uC694.
      \uC815\uBE44\uD560 \uB54C\uB9C8\uB2E4 \uCD5C\uB300 \uB0B4\uAD6C\uB3C4\uAC00
      \uC870\uAE08 \uC904\uC5B4, \uB9CE\uC774 \uB0A1\uC73C\uBA74 <b>\uC7AC\uAC74\uCD95</b>\uD569\uB2C8\uB2E4."
    _goal: 4
    _modules: []
    _highlight: 4
    _holdBeforeFirstNight: 0
  - _title: "\uC6B4\uC11D \uB300\uC751: \uC218\uB9AC"
    _body: "\uC6B4\uC11D\uC774 \uB2E4\uAC00\uC635\uB2C8\uB2E4! \uB9DE\uC740 \uBAA8\uB4C8\uC740
      <b>\uD30C\uC190</b>\uB418\uC5B4 \uBA48\uCD94\uACE0, \uC624\uB798 \uB450\uBA74
      \uC606\uC73C\uB85C \uBC88\uC9C0\uAC70\uB098 \uD30C\uAD34\uB429\uB2C8\uB2E4.\n\uD30C\uC190\uB41C
      \uBAA8\uB4C8(\uBE68\uAC04 \uD45C\uC2DC)\uC744 \uD074\uB9AD\uD558\uACE0 <b>\uC218\uB9AC</b>\uB97C
      \uB204\uB974\uC138\uC694. \uC218\uB9AC\uC5D0\uB294 \uAE08\uC18D\uC774 \uB4ED\uB2C8\uB2E4."
    _goal: 3
    _modules: []
    _highlight: 3
    _holdBeforeFirstNight: 0
  - _title: "\uB0B4\uBD80 \uB458\uB7EC\uBCF4\uAE30"
    _body: "\uC815\uAC70\uC7A5 \uC548\uC5D0\uB294 \uC8FC\uBBFC\uB4E4\uC774 \uC0B4\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \uBAA8\uB4C8\uC744 \uD074\uB9AD\uD558\uACE0 <b>[\uB4E4\uC5B4\uAC00\uAE30]</b>\uB97C
      \uB204\uB974\uBA74 1\uC778\uCE6D\uC73C\uB85C \uB0B4\uBD80\uB97C \uAC78\uC5B4
      \uB2E4\uB2D0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uC548\uC5D0\uC11C\uB294 \uC774\uB3D9
      \uD0A4\uC640 \uB9C8\uC6B0\uC2A4\uB85C \uC6C0\uC9C1\uC774\uACE0, <b>ESC</b>\uB85C
      \uBC16\uC5D0 \uB098\uC635\uB2C8\uB2E4."
    _goal: 5
    _modules: []
    _highlight: 5
    _holdBeforeFirstNight: 0
  - _title: "\uD734\uB300 \uD328\uB4DC"
    _body: "\uD328\uB4DC\uC5D0\uB294 \uC815\uAC70\uC7A5 \uC9C0\uB3C4\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
      \uC8FC\uBBFC \uBD80\uD0C1\uC774\uB098 \uC0AC\uACE0\uAC00 \uC0DD\uAE34 \uBC29\uC774
      \uC9C0\uB3C4\uC5D0 \uD45C\uC2DC\uB418\uACE0, \uB2E4\uB978 \uBC29\uC73C\uB85C
      \uBC14\uB85C \uC774\uB3D9\uD558\uAC70\uB098 \uBAA8\uB4C8\uC744 \uAD00\uB9AC\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uD328\uB4DC\uB97C \uB4E4\uC5B4 \uBCF4\uC138\uC694."
    _goal: 6
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uC8FC\uBBFC \uBD80\uD0C1"
    _body: "\uC8FC\uBBFC\uC774 \uBD80\uD0C1\uC744 \uD588\uC2B5\uB2C8\uB2E4. \uB204\uAC00
      \uC5B4\uB290 \uBC29\uC5D0\uC11C \uBD80\uD0C1\uD588\uB294\uC9C0 \uD654\uBA74
      \uC704\uCABD \uBC29 \uC774\uB984 \uC544\uB798\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\uCC3E\uC544\uAC00\uC11C
      \uB9D0\uD48D\uC120\uC758 \uBD80\uD0C1\uC744 \uB4E4\uC5B4\uC8FC\uBA74 <b>\uB9CC\uC871\uB3C4</b>\uAC00
      \uC624\uB985\uB2C8\uB2E4."
    _goal: 7
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
  - _title: "\uC0AC\uACE0 \uB300\uC751"
    _body: "\uBC29\uC5D0 \uC0AC\uACE0\uAC00 \uB0AC\uC2B5\uB2C8\uB2E4! \uD3C9\uC18C\uC5D0\uB294
      <b>\uC81C\uD55C \uC2DC\uAC04</b> \uC548\uC5D0 \uCC98\uB9AC\uD558\uC9C0 \uBABB\uD558\uAC70\uB098
      \uBC16\uC73C\uB85C \uB098\uAC00\uBA74 \uC790\uC6D0 \uC190\uC2E4\uC774 \uC0DD\uAE41\uB2C8\uB2E4.\n<color=#9AA4B2>\uC774\uBC88\uC740
      \uC5F0\uC2B5\uC774\uB77C \uC2DC\uAC04 \uC81C\uD55C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.</color>
      \uB9D0\uD48D\uC120 \uC548\uB0B4\uB300\uB85C \uCC98\uB9AC\uD558\uC138\uC694."
    _goal: 8
    _modules: []
    _highlight: 0
    _holdBeforeFirstNight: 0
